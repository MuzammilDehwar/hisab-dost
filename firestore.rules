rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // No anonymous/public access. Every user can read and write only their own
    // app state document, identified by the Firebase Auth UID.
    match /users/{userId}/app/state {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Any future collection must add an explicit rule above; everything else
    // remains inaccessible by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
